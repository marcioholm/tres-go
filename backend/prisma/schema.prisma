generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  taxId             String?            // CPF ou CNPJ para cobrança Asaas
  plan              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaigns         Campaign[]
  channels          Channel[]
  contacts          Contact[]
  conversations     Conversation[]
  flows             Flow[]
  users             WorkspaceUser[]
  businessHours     BusinessHours[]
  quickReplies      QuickReply[]
  knowledgeBase     KnowledgeBase[]
  kanbanBoards      KanbanBoard[]
  sectors           Sector[]
  sales             Sale[]
  scheduledMessages ScheduledMessage[]
  mediaUploads      MediaUpload[]
  deals             Deal[]
  auditLogs         AuditLog[]
  isBlocked         Boolean            @default(false)
  blockReason       String?
  subscription      Subscription?
  usage             WorkspaceUsage[]
  performanceConfig WorkspacePerformanceConfig?
  conversions       ConversationConversion[]
  pipelines         Pipeline[]
}

model Channel {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type          ChannelType // INSTAGRAM | MESSENGER | WHATSAPP
  name          String      // Nome amigável definido pelo usuário
  status        ChannelStatus @default(CONNECTING)

  // Meta OAuth (Instagram + Messenger)
  pageId        String?     // ID da Página do Facebook
  pageName      String?     // Nome da Página
  pageAvatar    String?     // URL da foto da Página
  accessToken   String?     // Page Access Token (criptografado)
  igAccountId   String?     // Instagram Account ID (só para Instagram)
  igUsername    String?     // Handle do Instagram (@usuario)

  // WhatsApp Business API
  phoneNumber   String?     // Número verificado
  phoneNumberId String?     // Phone Number ID da Meta
  wabaId        String?     // WhatsApp Business Account ID
  displayName   String?     // Nome de exibição no WhatsApp

  // Webhook
  webhookSecret String?     // Para validar assinatura do webhook

  config        Json?       // Configurações flexíveis (Z-API instance, Meta secrets, etc)

  zapiInstanceId String?     @unique // Cache for instanceId in config for fast lookup
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([zapiInstanceId])

  conversations     Conversation[]
  scheduledMessages ScheduledMessage[]
}

model MetaIntegration {
  id                         String   @id @default(cuid())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  pageId                     String   @unique
  pageName                   String
  pageAccessToken            String
  userAccessTokenLongLived   String
  igBusinessAccountId        String?
  tokenExpiresAt             DateTime?
  status                     String   @default("active")
}

enum ChannelType {
  INSTAGRAM
  MESSENGER
  WHATSAPP
  ZAPI
}

enum ChannelStatus {
  CONNECTING
  ACTIVE
  ERROR
  DISCONNECTED
}

// ── Contact: adicionar campos de origem
model Contact {
  id             String                   @id @default(cuid())
  workspaceId    String
  name           String?                  // Legado
  firstName      String?
  lastName       String?
  phone          String?
  email          String?
  avatarUrl      String?                  // URL da foto de perfil
  handle         String?                  // Instagram username ou handler
  externalId     String?                  // ID externo (Instagram ID, Messenger ID, etc)
  source         TrafficSource?
  sourceMedium   String?
  sourceCampaign String?
  sourceContent  String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  referredBy     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workspace      Workspace                @relation(fields: [workspaceId], references: [id])
  identities     ContactChannelIdentity[]
  notes          ContactNote[]
  conversations  Conversation[]
  ContactToTag   ContactToTag[]
  sales          Sale[]
  deals          Deal[]
  campaignLogs   CampaignContactLog[]
}

enum TrafficSource {
  GOOGLE_ADS
  GOOGLE_ORGANIC
  META_ADS
  META_ORGANIC
  WHATSAPP_DIRECT
  INSTAGRAM_DIRECT
  TIKTOK_ADS
  TIKTOK_ORGANIC
  YOUTUBE
  EMAIL_MARKETING
  INDICATION
  COLD_CALL
  EVENT
  OTHER
}

model ContactChannelIdentity {
  id         String  @id @default(cuid())
  contactId  String
  channel    String
  identifier String
  contact    Contact @relation(fields: [contactId], references: [id])
}

model Conversation {
  id                String              @id @default(cuid())
  workspaceId       String
  contactId         String
  channelId         String
  agentId           String?

  sectorId          String?
  sector            Sector?             @relation(fields: [sectorId], references: [id])
  status            String
  kanbanColumn      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  channel           Channel             @relation(fields: [channelId], references: [id])
  contact           Contact             @relation(fields: [contactId], references: [id])
  workspace         Workspace           @relation(fields: [workspaceId], references: [id])
  lastSeq           Int                 @default(0)
  messages          Message[]
  ConversationToTag ConversationToTag[]
  deals             Deal[]
  sales             Sale[]
  scheduledMessages ScheduledMessage[]
  transfers         ConversationTransfer[]
  archivedMessages  ArchivedMessage[]
  sessions          ConversationSession[]
  conversion        ConversationConversion?
  pipelineStages    ConversationPipelineStage[]
}

// ── Message: robust messaging pipeline
model Message {
  id             String       @id @default(cuid())
  conversationId String
  workspaceId    String?      // Mandatory for multi-tenancy in future
  channelId      String?
  
  fromAgent      Boolean      @default(false)
  senderName     String?      // Nome do agente que enviou (null = cliente)
  isInternalNote Boolean      @default(false)
  
  type           MessageType  @default(TEXT)
  content        Json?        // Texto ou metadados básicos
  status         String?      // PENDING, SENT, DELIVERED, READ, FAILED
  
  provider       MessageProvider @default(ZAPI)
  providerMessageId String?     // ID único no provedor
  providerTimestamp DateTime?    // Timestamp real do provedor
  receivedAt     DateTime     @default(now())
  sequence       Int          @default(0)

  // Media handling
  mediaOriginalUrl String?
  mediaFinalUrl    String?
  mediaMimeType    String?
  mediaFileName    String?
  mediaSize        Int?
  mediaStatus      MediaStatus   @default(NONE)

  // Reactions
  reactionEmoji                  String?
  reactionTargetProviderMessageId String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([workspaceId, createdAt])
  @@unique([channelId, provider, providerMessageId])
}

// ── ArchivedMessage: Data Warehouse para mensagens antigas
model ArchivedMessage {
  id             String       @id
  conversationId String
  workspaceId    String?
  channelId      String?
  
  fromAgent      Boolean
  senderName     String?
  isInternalNote Boolean
  
  type           MessageType
  content        Json?
  status         String?
  
  provider       MessageProvider
  providerMessageId String?
  providerTimestamp DateTime?
  receivedAt     DateTime
  sequence       Int
  
  mediaOriginalUrl String?
  mediaFinalUrl    String?
  mediaMimeType    String?
  mediaFileName    String?
  mediaSize        Int?
  mediaStatus      MediaStatus

  reactionEmoji                  String?
  reactionTargetProviderMessageId String?

  createdAt      DateTime
  archivedAt     DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  REACTION
  LOCATION
  CONTACT
  UNKNOWN
}

enum MessageProvider {
  ZAPI
  WA_CLOUD
  INSTAGRAM
  MESSENGER
}

enum MediaStatus {
  NONE
  PENDING
  READY
  FAILED
}


// ── Campaign: expandir com mídia, segmentação e métricas
model Campaign {
  id             String          @id @default(cuid())
  name           String
  workspaceId    String
  status         String
  config         Json
  type           CampaignType    @default(SIMPLE)
  content        String?         // Texto da mensagem (Legado/Simples)
  mediaUrl       String?
  mediaType      String?
  mediaCaption   String?
  mediaFilename  String?
  variables      Json?
  filterTagIds   String[]
  filterSource   TrafficSource?
  delayBetween   Int             @default(3000) // MÍNIMO 3000ms para Z-API
  repliesCount   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  steps          CampaignStep[]
  contactLogs    CampaignContactLog[]
}

model CampaignStep {
  id             String    @id @default(cuid())
  campaignId     String
  order          Int       // 0 = imediato (D0), 1 = segundo tiro, etc.
  delayHours     Int       @default(0) // Horas de espera a partir da etapa anterior
  content        String?
  mediaUrl       String?
  mediaType      String?
  mediaCaption   String?
  mediaFilename  String?
  variables      Json?
  condition      String?   // ex: "NO_REPLY", "ALWAYS"
  
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  logs           CampaignContactLog[]
  
  @@index([campaignId, order])
}

model CampaignContactLog {
  id             String       @id @default(cuid())
  campaignId     String
  contactId      String
  currentStepId  String?
  status         CampaignContactStatus @default(ACTIVE)
  nextExecutionAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id])
  currentStep    CampaignStep? @relation(fields: [currentStepId], references: [id])

  @@unique([campaignId, contactId])
  @@index([nextExecutionAt, status])
}

enum CampaignContactStatus {
  ACTIVE
  COMPLETED
  CANCELLED_REPLY
  FAILED
}

enum CampaignType {
  SIMPLE
  TEMPLATE
  MULTI_STEP
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  content   String
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id])
}

model Flow {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  nodes       Json
  edges       Json
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ContactToTag {
  A       String
  B       String
  Contact Contact @relation(fields: [A], references: [id], onDelete: Cascade)
  Tag     Tag     @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ContactToTag_AB_pkey")
  @@index([B], map: "_ContactToTag_B_index")
  @@map("_ContactToTag")
}

model ConversationToTag {
  A            String
  B            String
  Conversation Conversation @relation(fields: [A], references: [id], onDelete: Cascade)
  Tag          Tag          @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ConversationToTag_AB_pkey")
  @@index([B], map: "_ConversationToTag_B_index")
  @@map("_ConversationToTag")
}

model BusinessHours {
  id          String    @id @default(cuid())
  workspaceId String
  dayOfWeek   Int
  isOpen      Boolean   @default(true)
  openTime    String
  closeTime   String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model QuickReply {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  command     String
  title       String
  content     String
  category    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, command])
  @@index([workspaceId])
}

model KnowledgeBase {
  id          String    @id @default(cuid())
  workspaceId String
  question    String
  answer      String
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceUser {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?            // Legado
  firstName         String?
  lastName          String?
  niche             String?            // Farmácia, Gastronomia, Varejo, etc.
  password          String
  status            String             @default("ONLINE") // ONLINE, BUSY, OFFLINE
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspaces        WorkspaceUser[]
  sectorMembers     SectorMember[]
  transfersFrom     ConversationTransfer[] @relation("TransferFromAgent")
  transfersTo       ConversationTransfer[] @relation("TransferToAgent")
  deals             Deal[]
  sales             Sale[]
  scheduledMessages ScheduledMessage[]
  uploadedFiles     MediaUpload[]
  auditLogs         AuditLog[]
  superAdmin        SuperAdmin?
  legalAcceptance   LegalAcceptance?
  sessions          ConversationSession[]
}

// ── Legal Acceptance: auditoria LGPD
model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion   String   @default("1.0")
  privacyVersion String   @default("1.0")
  acceptedAt     DateTime @default(now())
  ip             String?
  userAgent      String?
}

// ── Tag: adicionar campo type
model Tag {
  id                String              @id @default(cuid())
  name              String
  color             String?
  workspaceId       String?
  type              TagType             @default(GENERAL)
  ContactToTag      ContactToTag[]
  ConversationToTag ConversationToTag[]
  deals             DealTag[]
}

enum TagType {
  GENERAL
  REMARKETING
  SEGMENT
  STATUS
}

// ── KANBAN ────────────────────────────────────────────────

model KanbanBoard {
  id          String        @id @default(cuid())
  workspaceId String
  name        String        @default("Funil de Vendas")
  createdAt   DateTime      @default(now())
  columns     KanbanColumn[]
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sectorId    String?       @unique
  sector      Sector?       @relation(fields: [sectorId], references: [id])

  @@index([workspaceId])
}

model KanbanColumn {
  id      String  @id @default(cuid())
  boardId String
  name    String
  order   Int
  color   String  @default("#6366f1")
  isWon   Boolean @default(false) // coluna "Ganho"
  isLost  Boolean @default(false) // coluna "Perdido"
  board   KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  deals   Deal[]

  @@index([boardId, order])
}

model Deal {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  columnId       String
  conversationId String?
  title          String
  value          Float?
  agentId        String?
  order          Int       @default(0)
  notes          String?
  expectedCloseAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id])
  column         KanbanColumn  @relation(fields: [columnId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  agent          User?         @relation(fields: [agentId], references: [id])
  tags           DealTag[]

  @@index([workspaceId, columnId])
  @@index([workspaceId, contactId])
  @@index([contactId, createdAt])
}

model DealTag {
  dealId String
  tagId  String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([dealId, tagId])
}

// ── VENDAS ────────────────────────────────────────────────

model Sale {
  id             String     @id @default(cuid())
  workspaceId    String
  contactId      String
  conversationId String?
  agentId        String
  title          String
  description    String?
  amount         Float
  status         SaleStatus @default(COMPLETED)
  saleDate       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  agent          User          @relation(fields: [agentId], references: [id])
  items          SaleItem[]

  @@index([workspaceId, contactId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, agentId])
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  REFUNDED
}

model SaleItem {
  id         String @id @default(cuid())
  saleId     String
  name       String
  quantity   Int    @default(1)
  unitPrice  Float
  total      Float
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// ── MENSAGENS AGENDADAS ───────────────────────────────────

model ScheduledMessage {
  id             String          @id @default(cuid())
  workspaceId    String
  conversationId String
  channelId      String
  agentId        String
  type           String          @default("TEXT")
  content        Json
  scheduledAt    DateTime
  status         ScheduledStatus @default(PENDING)
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime        @default(now())

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  channel        Channel      @relation(fields: [channelId], references: [id])
  agent          User         @relation(fields: [agentId], references: [id])

  @@index([status, scheduledAt])
}

enum ScheduledStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ── UPLOADS / MÍDIA ───────────────────────────────────────

model MediaUpload {
  id          String   @id @default(cuid())
  workspaceId String
  uploadedBy  String
  url         String
  filename    String
  mimeType    String
  size        Int
  mediaType   String
  isPtt       Boolean  @default(false)
  duration    Int?
  waveform    Json?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader    User      @relation(fields: [uploadedBy], references: [id])

  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   // "WHATSAPP" | "ZAPI"
  instanceId      String?
  phoneNumberId   String?
  externalId      String?
  payload         Json
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  status          String   @default("PENDING") // PENDING, PROCESSED, ERROR
  error           String?
  
  @@index([status])
  @@index([provider, externalId])
}

// ── SETOR (Departamento) ──────────────────────────────────────────────────────

model Sector {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String                        // "Comercial", "Financeiro", "Suporte"...
  description   String?
  color         String   @default("#6366f1")  // cor para identificação visual
  icon          String   @default("business") // Material Symbol icon name
  isDefault     Boolean  @default(false)      // setor padrão para novos atendimentos
  isActive      Boolean  @default(true)
  order         Int      @default(0)          // ordem de exibição
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       SectorMember[]
  conversations Conversation[]
  kanbanBoard   KanbanBoard?   // cada setor tem seu próprio Kanban
  slaConfig     SectorSla?
  autoRules     SectorAutoRule[]
  transfersFrom ConversationTransfer[] @relation("TransfersFrom")
  transfersTo   ConversationTransfer[] @relation("TransfersTo")
  pipeline      Pipeline?

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
}

// ── MEMBROS DO SETOR ─────────────────────────────────────────────────────────

model SectorMember {
  id        String     @id @default(cuid())
  sectorId  String
  userId    String
  role      SectorRole @default(AGENT)       // SUPERVISOR ou AGENT dentro do setor
  createdAt DateTime   @default(now())

  sector    Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId])
  @@index([sectorId])
  @@index([userId])
}

enum SectorRole {
  SUPERVISOR  // supervisiona o setor, vê relatórios, pode transferir para qualquer lugar
  AGENT       // atende conversas do setor
}

// ── SLA POR SETOR ────────────────────────────────────────────────────────────

model SectorSla {
  id                  String @id @default(cuid())
  sectorId            String @unique
  firstResponseTime   Int    @default(5)    // minutos para primeira resposta
  resolutionTime      Int    @default(120)  // minutos para resolução
  warningThreshold    Int    @default(80)   // % do tempo usado → dispara alerta amarelo
  criticalThreshold   Int    @default(100)  // % → alerta vermelho

  sector              Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

// ── REGRAS DE ROTEAMENTO AUTOMÁTICO ──────────────────────────────────────────

model SectorAutoRule {
  id          String         @id @default(cuid())
  sectorId    String                               // setor de DESTINO
  type        AutoRuleType
  value       String                               // keyword ou channelId ou tagId
  priority    Int            @default(0)           // maior priority = verificado primeiro
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  sector      Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

enum AutoRuleType {
  KEYWORD       // palavra-chave na primeira mensagem → direciona ao setor
  CHANNEL       // canal de origem (ex: todas IG → Comercial)
  TAG           // contato com tag específica → setor específico
  BUSINESS_HOUR // fora do horário → setor de plantão
}

// ── HISTÓRICO DE TRANSFERÊNCIAS ───────────────────────────────────────────────

model ConversationTransfer {
  id               String   @id @default(cuid())
  conversationId   String
  fromSectorId     String?  // null = sem setor anterior
  toSectorId       String
  fromAgentId      String?
  toAgentId        String?  // null = vai para a fila do setor sem agente específico
  reason           String?  // motivo da transferência
  note             String?  // nota interna automática
  transferredAt    DateTime @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  fromSector       Sector?  @relation("TransfersFrom", fields: [fromSectorId], references: [id])
  toSector         Sector   @relation("TransfersTo", fields: [toSectorId], references: [id])
  fromAgent        User?    @relation("TransferFromAgent", fields: [fromAgentId], references: [id])
  toAgent          User?    @relation("TransferToAgent", fields: [toAgentId], references: [id])

  @@index([conversationId])
  @@index([toSectorId, transferredAt])
}

// ── PLANOS ────────────────────────────────────────────────────────────────────

model Plan {
  id                  String   @id @default(cuid())
  name                String   @unique   // "Starter", "Growth", "Pro", "Enterprise"
  slug                String   @unique   // "starter", "growth", "pro", "enterprise"
  description         String?
  priceMonthly        Float              // R$ por mês
  priceYearly         Float              // R$ por ano (com desconto)
  isActive            Boolean  @default(true)
  isPublic            Boolean  @default(true)  // false = só Super Admin pode atribuir
  trialDays           Int      @default(14)

  // Limites do plano
  maxAgents           Int      @default(2)     // máx de agentes
  maxChannels         Int      @default(1)     // máx de canais conectados
  maxConversationsPerMonth Int  @default(500)  // conversas/mês
  maxCampaigns        Int      @default(0)     // campanhas/mês (0 = sem acesso)
  maxStorage          Int      @default(1024)  // MB de storage de mídia
  maxSectors          Int      @default(1)     // setores/departamentos

  // Features (boolean por feature)
  hasKanban           Boolean  @default(false)
  hasChatbot          Boolean  @default(false)
  hasAI               Boolean  @default(false)
  hasReports          Boolean  @default(false)
  hasAPI              Boolean  @default(false)
  hasWhiteLabel       Boolean  @default(false)
  hasMultiSectors     Boolean  @default(false)
  hasCampaigns        Boolean  @default(false)
  hasSalesHistory     Boolean  @default(false)
  hasScheduledMessages Boolean @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions       Subscription[]
}

// ── ASSINATURA DO WORKSPACE ───────────────────────────────────────────────────

model Subscription {
  id                  String             @id @default(cuid())
  workspaceId         String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIAL)
  billingCycle        BillingCycle       @default(MONTHLY)

  // Asaas IDs
  asaasCustomerId     String?            // ID do cliente no Asaas
  asaasSubscriptionId String?            // ID da assinatura no Asaas

  // Datas
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?
  blockedAt           DateTime?          // quando foi bloqueado por inadimplência

  // Cobrança
  priceOverride       Float?             // preço customizado (Enterprise)
  discountPercent     Float?             // desconto aplicado

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id])
  invoices            Invoice[]
}

enum SubscriptionStatus {
  TRIAL         // período de teste gratuito
  ACTIVE        // ativo e em dia
  PAST_DUE      // boleto vencido, mas ainda com acesso (grace period)
  BLOCKED       // bloqueado por inadimplência (sem acesso ao sistema)
  CANCELLED     // cancelado pelo cliente ou admin
  SUSPENDED     // suspenso manualmente pelo Super Admin
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ── FATURAS ───────────────────────────────────────────────────────────────────

model Invoice {
  id               String        @id @default(cuid())
  subscriptionId   String
  asaasPaymentId   String?       @unique  // ID do pagamento no Asaas
  amount           Float
  status           InvoiceStatus @default(PENDING)
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String?       // BOLETO | PIX | CREDIT_CARD
  invoiceUrl       String?       // URL do boleto/PIX no Asaas
  pixQrCode        String?       // QR Code PIX
  pixCopiaECola    String?       // código copia e cola
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription     Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  PENDING     // aguardando pagamento
  PAID        // pago
  OVERDUE     // vencido sem pagamento
  CANCELLED   // cancelado
  REFUNDED    // reembolsado
}

// ── SUPER ADMIN ───────────────────────────────────────────────────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Performance & Métricas ────────────────────────────────

model WorkspacePerformanceConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Atribuição de vendas
  saleAttribution      SaleAttribution  @default(LAST_AGENT)
  manualAttribution    Boolean          @default(false)

  // Cálculo de tempo
  timeCalculation      TimeCalculation  @default(ACTIVE_ONLY)
  inactivityThreshold  Int              @default(30)  // minutos

  // Transferências
  resetTimerOnTransfer Boolean          @default(false)
  transferCountsConversion Boolean      @default(false)

  // Metas
  firstResponseGoal    Int              @default(5)    // minutos
  resolutionGoal       Int              @default(1440) // minutos (24h)
  conversionRateGoal   Float            @default(30.0) // percentual

  // Visibilidade de relatórios
  reportVisibility     ReportVisibility @default(ADMIN_ONLY)
  defaultReportPeriod  ReportPeriod     @default(MONTHLY)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConversationSession {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User         @relation(fields: [agentId], references: [id])

  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  endReason      SessionEndReason?

  // Métricas calculadas ao fechar sessão
  durationMinutes     Int?
  messagesSent        Int      @default(0)
  messagesReceived    Int      @default(0)
  firstResponseAt     DateTime?
  firstResponseMinutes Int?

  createdAt      DateTime @default(now())

  @@index([agentId])
  @@index([conversationId])
}

model ConversationConversion {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Atribuição
  primaryAgentId    String?   // Agente principal (conforme regra configurada)
  allAgentIds       String[]  // Todos os agentes que participaram

  // Dados da conversão
  value             Float?    // Valor da venda (opcional)
  convertedAt       DateTime  @default(now())
  convertedById     String    // Quem marcou como convertido

  createdAt      DateTime @default(now())
}

enum SaleAttribution {
  LAST_AGENT
  FIRST_AGENT
  EQUAL_SPLIT
  MANUAL
}

enum TimeCalculation {
  TOTAL
  ACTIVE_ONLY
}

enum ReportVisibility {
  ADMIN_ONLY
  ALL_AGENTS
}

enum ReportPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum SessionEndReason {
  RESOLVED
  TRANSFERRED
  REASSIGNED
}

// ── USO DO WORKSPACE (MÉTRICAS) ───────────────────────────────────────────────

model WorkspaceUsage {
  id                  String   @id @default(cuid())
  workspaceId         String
  month               Int      // 1-12
  year                Int
  conversationsCount  Int      @default(0)
  messagesCount       Int      @default(0)
  campaignsSent       Int      @default(0)
  storageUsedMb       Float    @default(0)
  agentsActive        Int      @default(0)

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month, year])
  @@index([workspaceId, year, month])
}

// ── AUDITORIA DE SISTEMA ──────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?  // Pode ser nulo se a ação for do sistema automático
  actionType  String   // ex: "DEAL_MOVED", "DEAL_UPDATED", "LEAD_DELETED", "LEAD_MERGED" ou "workspace.blocked"
  entityType  String?   // ex: "Deal", "Contact", "KanbanColumn"
  entityId    String?   // ID da entidade alterada
  target      String?  // ID do recurso afetado (sistema/billing/super-admin)
  metadata    Json?    // dados extras
  ip          String?
  oldValue    Json?    // Estado anterior
  newValue    Json?    // Novo estado
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, actionType])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ── Funis de Vendas (Pipelines) ──────────────────────────────────────────

model Pipeline {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sectorId     String?     @unique
  sector       Sector?     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  isDefault    Boolean     @default(false)
  stages       PipelineStage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, sectorId])
  @@index([workspaceId])
}

model PipelineStage {
  id           String   @id @default(cuid())
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name         String
  color        String   @default("#6366f1")
  order        Int
  isConversion Boolean  @default(false)

  keywords     PipelineKeyword[]
  conversations ConversationPipelineStage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pipelineId])
}

model PipelineKeyword {
  id        String        @id @default(cuid())
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  phrase    String
  matchType KeywordMatchType @default(CONTAINS)

  createdAt DateTime @default(now())

  @@index([stageId])
}

enum KeywordMatchType {
  CONTAINS
  EXACT
  STARTS_WITH
}

model ConversationPipelineStage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])

  movedBy        MovedBy
  triggeredBy    String?
  movedById      String?

  createdAt      DateTime @default(now())

  @@index([conversationId])
}

enum MovedBy {
  AUTOMATIC
  MANUAL
}
